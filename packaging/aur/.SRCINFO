pkgbase = dockwatch
	pkgdesc = Live port map of your docking station and laptop (ThinkPad style): tray, GUI and TUI, plug/unplug notifications
	pkgver = 0.3.0
	pkgrel = 1
	url = https://github.com/Watashik/DockWatch
	arch = any
	license = MIT
	makedepends = git
	depends = python
	depends = python-pyside6
	optdepends = udisks2: safely remove and open drives and SD cards from the port map
	optdepends = libpulse: microphone and sound state (pactl)
	optdepends = networkmanager: Wi-Fi network and signal in the header
	optdepends = bluez-utils: connected Bluetooth devices and their battery
	optdepends = power-profiles-daemon: switch power profile from the menu
	source = dockwatch::git+https://github.com/Watashik/DockWatch.git#tag=v0.3.0
	sha256sums = SKIP

pkgname = dockwatch
